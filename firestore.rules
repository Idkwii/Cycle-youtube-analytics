rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ID Validation Helper
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions for readability
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Blueprint (Zero-Trust Field Constraints)
    function isValidDashboard(data) {
      return data.keys().hasAll(['folders', 'channels'])
          && (data.keys().size() >= 2 && data.keys().size() <= 6)
          && data.folders is list
          && data.folders.size() <= 100
          && data.channels is list
          && data.channels.size() <= 200;
    }

    // Hardened Dashboard collection
    match /dashboards/{dashboardId} {
      // Direct GET allows viewing dashboards by precisely knowing the ID
      allow get: if isValidId(dashboardId);
      
      // Prohibit full-collection listing/scrapes
      allow list: if false;
      
      // Document Creation
      allow create: if isValidId(dashboardId)
                    && isValidDashboard(incoming())
                    && (incoming().get('createdAt', request.time) == request.time)
                    && (incoming().get('updatedAt', request.time) == request.time);

      // Document Updates
      allow update: if isValidId(dashboardId)
                    && isValidDashboard(incoming())
                    && (incoming().get('updatedAt', request.time) == request.time)
                    && (!incoming().keys().hasAny(['createdAt']) || incoming().get('createdAt', existing().createdAt) == existing().createdAt);

      // Deny public deletions
      allow delete: if false;
    }
  }
}
